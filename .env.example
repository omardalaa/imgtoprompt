# App
NEXT_PUBLIC_APP_URL=https://promptshotai.com
NEXTAUTH_URL=https://promptshotai.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Database (Neon PostgreSQL)
# Pooler URL — used at runtime by Prisma Client
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
# Direct URL — used by Prisma CLI for migrations/db push
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# GitHub OAuth (github.com/settings/developers) — optional
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Stripe (dashboard.stripe.com/developers)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_BUSINESS_PRICE_ID=price_xxx

# OpenAI (platform.openai.com)
OPENAI_API_KEY=sk-proj-xxx
